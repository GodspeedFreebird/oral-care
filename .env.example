# ===================================================
# Oral Care (OAUTHC Dental Centre) Environment Config
# ===================================================

# Application
APP_ENV=production
PORT=80

# Cloud Database Configuration (e.g. Aiven MySQL / TiDB)
DB_HOST=mysql-xxxx-project.aivencloud.com
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASS=your_aiven_password_here
DB_CHARSET=utf8mb4

# Optional: Path to Cloud DB SSL CA Certificate (or paste certificate text into DB_SSL_CA_CONTENT)
# DB_SSL_CA=/etc/ssl/certs/cloud_db_ca.pem
# DB_SSL_CA_CONTENT=""
# DB_SSL_VERIFY_SERVER_CERT=false

# SMTP Mail Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=placeholder@example.com
SMTP_PASS=placeholder_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=dental@oauthc.edu.ng
SMTP_FROM_NAME=OAUTHC Dental Centre
